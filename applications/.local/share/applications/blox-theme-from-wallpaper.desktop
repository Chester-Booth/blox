[Desktop Entry]
Type=Application
Name=Create Theme from Current Wallpaper
Comment=Generate an editable Blox theme from the current wallpaper
Exec=quickshell ipc -c blox call themePicker generateCurrent
Icon=blox-theme-from-wallpaper
Terminal=false
Categories=Settings;
Keywords=theme;appearance;colour;wallpaper;matugen;
StartupNotify=false
