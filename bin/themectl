#!/usr/bin/env python3
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
for candidate in (root / "themes" / "lib", root / "lib"):
    if (candidate / "blox_theme").is_dir():
        sys.path.insert(0, str(candidate))
        break

from blox_theme.cli import main

raise SystemExit(main())
