{
  "colours": {
    "accent": "#1e66f5",
    "background": "#eff1f5",
    "border": "#9ca0b0",
    "danger": "#d20f39",
    "foreground": "#4c4f69",
    "info": "#209fb5",
    "mauve": "#8839ef",
    "muted": "#5c5f77",
    "selection_background": "#8839ef",
    "selection_foreground": "#eff1f5",
    "success": "#40a02b",
    "surface": "#e6e9ef",
    "surface_alt": "#ccd0da",
    "teal": "#179299",
    "warning": "#df8e1d"
  },
  "cursor": {
    "base": "Bibata-Modern-Classic",
    "base_colour": "#1e66f5",
    "colour_source": "theme",
    "handedness": "right",
    "mode": "generated",
    "outline_colour": "#eff1f5",
    "sizes": [
      22,
      24
    ],
    "watch_background": "#eff1f5"
  },
  "fonts": {
    "editor_size": 13,
    "gtk_size": 11,
    "mono": "CaskaydiaCove Nerd Font Mono",
    "panel": "CaskaydiaCove Nerd Font Propo",
    "terminal_size": 12,
    "ui": "Nunito"
  },
  "gtk": {
    "base_theme": "Graphite-Light-compact",
    "colour_source": "theme",
    "mode": "generated"
  },
  "icons": {
    "theme": "Adwaita"
  },
  "id": "catppuccin-latte",
  "name": "Catppuccin Latte",
  "overrides": {
    "ansi": {
      "color0": "#5c5f77",
      "color1": "#d20f39",
      "color10": "#40a02b",
      "color11": "#df8e1d",
      "color12": "#1e66f5",
      "color13": "#ea76cb",
      "color14": "#179299",
      "color15": "#bcc0cc",
      "color2": "#40a02b",
      "color3": "#df8e1d",
      "color4": "#1e66f5",
      "color5": "#ea76cb",
      "color6": "#179299",
      "color7": "#acb0be",
      "color8": "#6c6f85",
      "color9": "#d20f39"
    }
  },
  "schema_version": 1,
  "shell": {
    "bar": {
      "items": [
        {
          "enabled": true,
          "id": "workspaces",
          "order": 0,
          "region": "start"
        },
        {
          "enabled": true,
          "id": "active-window-title",
          "order": 1,
          "orientation": "inward",
          "region": "start"
        },
        {
          "enabled": true,
          "id": "clock",
          "order": 0,
          "region": "centre"
        },
        {
          "enabled": true,
          "id": "tray",
          "order": 0,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "wifi",
          "order": 1,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "sound",
          "order": 2,
          "region": "end"
        },
        {
          "display": "numeric",
          "enabled": true,
          "id": "battery",
          "order": 3,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "notifications",
          "order": 4,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "power",
          "order": 5,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "application-tray",
          "order": 0,
          "region": "hidden"
        }
      ],
      "position": "top"
    },
    "notifications": {
      "offset_x": 0,
      "offset_y": 0,
      "position": "bottom-right"
    },
    "osd": {
      "offset_x": 0,
      "offset_y": 0,
      "position": "centre-bottom"
    }
  },
  "targets": {
    "btop": true,
    "code": true,
    "cursor": true,
    "cursor_editor": true,
    "glow": true,
    "grub": false,
    "gtk": true,
    "hyprland": true,
    "hyprlock": true,
    "kitty": true,
    "micro": true,
    "obsidian": true,
    "powerlevel10k": true,
    "quickshell": true,
    "sddm": false,
    "stylus": true,

    "wallpaper": true,
    "widgets": true
  },
  "terminal": {
    "ansi_source": "override",
    "canvas": "#eff1f5",
    "chrome_background": "#e6e9ef"
  },
  "variant": "light",
  "wallpaper": {
    "fit": "cover",
    "path": "wallpapers/showcase/catppuccin-latte.webp"
  },
  "widgets": {
    "profile": "minimal"
  }
