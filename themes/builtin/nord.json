  "shell": {
    "bar": {
      "border": false,
      "density_automatic": true,
      "density_scale": 1.0,
      "edge_inset": 0,
      "items": [
        {
          "enabled": true,
          "id": "workspaces",
          "order": 0,
          "region": "start"
        },
        {
          "enabled": true,
          "id": "active-window-title",
          "order": 1,
          "orientation": "horizontal",
          "region": "start"
        },
        {
          "enabled": true,
          "id": "clock",
          "order": 0,
          "region": "centre"
        },
        {
          "enabled": true,
          "id": "tray",
          "order": 0,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "wifi",
          "order": 1,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "sound",
          "order": 2,
          "region": "end"
        },
        {
          "display": "icon",
          "enabled": true,
          "id": "battery",
          "order": 3,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "power",
          "order": 4,
          "region": "end"
        },
        {
          "enabled": true,
          "id": "application-tray",
          "order": 0,
          "region": "hidden"
        }
      ],
      "position": "left",
      "radius_automatic": true,
      "radius_scale": 1.25,
      "separate_groups": false
    },
    "notifications": {
      "offset_x": 0,
      "offset_y": 0,
      "position": "top-right"
