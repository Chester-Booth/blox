{
  "schema_version": 1,
  "defaults_version": 1,
  "theme": {
    "id": "catppuccin-frappe",
    "name": "Catppuccin Frappé",
    "variant": "dark",
    "colours": {
      "background": "#303446",
      "surface": "#414559",
      "surface_alt": "#51576d",
      "foreground": "#c6d0f5",
      "muted": "#a5adce",
      "red": "#e78284",
      "green": "#a6d189",
      "yellow": "#e5c890",
      "accent": "#8caaee",
      "blue": "#85c1dc",
      "mauve": "#ca9ee6",
      "teal": "#81c8be",
      "selection_background": "#8caaee",
      "selection_foreground": "#303446",
      "border": "#737994"
    },
    "fonts": {
      "panel": "VictorMono Nerd Font Propo",
      "mono": "VictorMono Nerd Font Mono",
      "ui": "Rubik",
      "terminal_size": 12,
      "editor_size": 13,
      "gtk_size": 11
    },
    "gtk": {
      "base_theme": "Graphite-Dark-compact",
      "colour_source": "theme",
      "mode": "generated"
    },
    "icons": {
      "theme": "Adwaita"
    },
    "cursor": {
      "base": "Bibata-Modern-Classic",
      "base_colour": "#8caaee",
      "colour_source": "theme",
      "handedness": "right",
      "mode": "generated",
      "outline_colour": "#232634",
      "shape_source": "theme",
      "sizes": [22, 24],
      "watch_background": "#303446"
    },
    "shape": {
      "radius_scale": 1.25,
      "density_scale": 1.0,
      "window_gap": null
    },
    "hyprland": {
      "border_size": 1,
      "inactive_opacity": 1.0
    },
    "shell": {
      "bar": {
        "border": false,
        "density_automatic": true,
        "density_scale": 1.0,
        "edge_inset": 0,
        "position": "left",
        "radius_automatic": true,
        "radius_scale": 1.25,
        "separate_groups": false,
        "items": [
          {"id": "power", "enabled": true, "region": "start", "order": 0},
          {"id": "notes", "enabled": true, "region": "start", "order": 1},
          {"id": "workspaces", "enabled": true, "region": "start", "order": 2},
          {"id": "clock", "enabled": true, "region": "centre", "order": 0},
          {"id": "active-window-title", "enabled": false, "region": "centre", "order": 1, "orientation": "inward", "titleLength": "truncate"},
          {"id": "battery", "enabled": true, "region": "end", "order": 0, "display": "toggle"},
          {"id": "tray", "enabled": true, "region": "end", "order": 1},
          {"id": "notifications", "enabled": true, "region": "end", "order": 2},
          {"id": "wifi", "enabled": true, "region": "end", "order": 3},
          {"id": "sound", "enabled": true, "region": "end", "order": 4},
          {"id": "privacy", "enabled": true, "region": "hidden", "order": 0, "visibility": "normal"},
          {"id": "awake", "enabled": true, "region": "hidden", "order": 1},
          {"id": "display", "enabled": true, "region": "hidden", "order": 2},
          {"id": "bt", "enabled": true, "region": "hidden", "order": 3},
          {"id": "updates", "enabled": true, "region": "hidden", "order": 4},
          {"id": "fan", "enabled": true, "region": "hidden", "order": 5, "visibility": "normal"},
          {"id": "gpu", "enabled": true, "region": "hidden", "order": 6, "visibility": "normal"},
          {"id": "application-tray", "enabled": true, "region": "hidden", "order": 7},
          {"id": "touchpad", "enabled": true, "region": "hidden", "order": 8, "visibility": "normal"}
        ],
        "reset_items": [
          {"id": "power", "enabled": true, "region": "start", "order": 0},
          {"id": "workspaces", "enabled": true, "region": "start", "order": 1},
          {"id": "clock", "enabled": true, "region": "centre", "order": 0},
          {"id": "tray", "enabled": true, "region": "end", "order": 0},
          {"id": "wifi", "enabled": true, "region": "end", "order": 1},
          {"id": "sound", "enabled": true, "region": "end", "order": 2},
          {"id": "battery", "enabled": true, "region": "end", "order": 3, "display": "icon"},
          {"id": "application-tray", "enabled": true, "region": "hidden", "order": 0}
        ]
      },
      "osd": {"position": "centre-bottom", "offset_x": 0, "offset_y": 0},
      "notifications": {"position": "top-right", "offset_x": 0, "offset_y": 0}
    },
    "wallpaper": {"path": "wallpapers/showcase/catppuccin-frappe.webp", "fit": "cover"},
    "targets": {
      "btop": false,
      "code": false,
      "cursor": false,
      "cursor_editor": false,
      "t3code": false,
      "zed": false,
      "glow": false,
      "grub": false,
      "gtk": false,
      "helium": false,
      "chromium": false,
      "hyprland": false,
      "hyprlock": false,
      "kitty": false,
      "micro": false,
      "obsidian": false,
      "powerlevel10k": false,
      "quickshell": false,
      "sddm": false,
      "stylus": false,
      "wallpaper": false,
      "widgets": false
    },
    "stylus": {
      "style_set": "recommended"
    },
    "terminal": {
      "canvas": "#303446",
      "chrome_background": "#292c3c",
      "ansi_source": "override"
    }
  },
  "widgets": {
    "profile": "compact",
    "profiles": {
      "minimal": {"opacity": 0.3, "margin": 20, "padding": 20, "radius": 0, "font_size": 14},
      "compact": {"opacity": 0.52, "margin": 12, "padding": 12, "radius": 6, "font_size": 12},
      "comfortable": {"opacity": 0.42, "margin": 24, "padding": 24, "radius": 10, "font_size": 15}
    }
  }
}
