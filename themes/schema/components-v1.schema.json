{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blox.local/schemas/theme-components-v1.json",
  "title": "Blox theme component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "settingsSchemaVersion",
    "legacyThemeSchemaVersion",
    "compatibility",
    "defaultSources",
    "bundlePresets",
    "selectableComponents",
    "components",
    "derivedFields"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "settingsSchemaVersion": {
      "const": 1
    },
    "legacyThemeSchemaVersion": {
      "const": 1
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "legacyThemeSchema": {
          "type": "string"
        },
        "readExistingThemeV1": {
          "const": true
        },
        "rewriteExistingThemeFiles": {
          "const": false
        },
        "unmappedFieldPolicy": {
          "type": "string",
          "enum": [
            "preserve-as-dormant-data"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "legacyThemeSchema",
        "readExistingThemeV1",
        "rewriteExistingThemeFiles",
        "unmappedFieldPolicy"
      ]
    },
    "defaultSources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "bundlePresets": {
      "type": "object",
      "properties": {
        "minimal": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "standard": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "full": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "minimal",
        "standard",
        "full"
      ]
    },
    "selectableComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "documentPath": {
            "type": "string",
            "minLength": 1
          },
          "storageOwner": {
            "type": "string",
            "minLength": 1
          },
          "runtimeOwner": {
            "type": "string",
            "minLength": 1
          },
          "legacyReadPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "presetIncluded": {
            "type": "object",
            "properties": {
              "minimal": {
                "type": "boolean"
              },
              "standard": {
                "type": "boolean"
              },
              "full": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "minimal",
              "standard",
              "full"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "documentPath",
          "storageOwner",
          "runtimeOwner",
          "legacyReadPaths",
          "presetIncluded"
        ]
      }
    },
    "derivedFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedField"
      }
    }
  },
  "$defs": {
    "derivedField": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "runtimeOwner": {
          "type": "string",
          "minLength": 1
        },
        "persisted": {
          "const": false
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "ownership-conflict"
          ]
        },
        "conflict": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "runtimeOwner",
        "persisted",
        "status",
        "conflict",
        "evidence"
      ]
    }
  }
}
