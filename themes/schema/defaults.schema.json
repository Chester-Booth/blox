{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blox.local/schemas/defaults-v1.json",
  "title": "Blox defaults document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "defaults_version", "theme", "widgets"],
  "properties": {
    "schema_version": {"const": 1},
    "defaults_version": {"const": 1},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "variant", "colours", "fonts", "shape", "shell", "wallpaper", "gtk", "icons", "cursor", "targets", "terminal"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "variant": {"enum": ["dark", "light"]},
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius_scale", "density_scale"],
          "properties": {
            "radius_scale": {"type": "number", "minimum": 0, "maximum": 2},
            "density_scale": {"type": "number", "minimum": 0.75, "maximum": 1.5},
            "window_gap": {"type": "integer", "minimum": 0, "maximum": 30}
          }
        },
        "colours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "surface", "surface_alt", "foreground", "muted", "red", "green", "yellow", "accent", "blue", "mauve", "teal", "selection_background", "selection_foreground", "border"],
          "properties": {
            "background": {"$ref": "#/$defs/colour"},
            "surface": {"$ref": "#/$defs/colour"},
            "surface_alt": {"$ref": "#/$defs/colour"},
            "foreground": {"$ref": "#/$defs/colour"},
            "muted": {"$ref": "#/$defs/colour"},
            "red": {"$ref": "#/$defs/colour"},
            "green": {"$ref": "#/$defs/colour"},
            "yellow": {"$ref": "#/$defs/colour"},
            "accent": {"$ref": "#/$defs/colour"},
            "blue": {"$ref": "#/$defs/colour"},
            "mauve": {"$ref": "#/$defs/colour"},
            "teal": {"$ref": "#/$defs/colour"},
            "selection_background": {"$ref": "#/$defs/colour"},
            "selection_foreground": {"$ref": "#/$defs/colour"},
            "border": {"$ref": "#/$defs/colour"}
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["panel", "mono", "ui", "terminal_size", "editor_size", "gtk_size"],
          "properties": {
            "panel": {"type": "string", "minLength": 1},
            "mono": {"type": "string", "minLength": 1},
            "ui": {"type": "string", "minLength": 1},
            "terminal_size": {"type": "number", "minimum": 6, "maximum": 48},
            "editor_size": {"type": "number", "minimum": 6, "maximum": 48},
            "gtk_size": {"type": "number", "minimum": 6, "maximum": 48}
          }
        },
        "gtk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "base_theme", "colour_source"],
          "properties": {
            "mode": {"enum": ["generated", "installed"]},
            "base_theme": {"type": "string", "minLength": 1},
            "colour_source": {"enum": ["theme", "override"]}
          }
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme"],
          "properties": {"theme": {"type": "string", "minLength": 1}}
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "base", "handedness", "sizes", "colour_source"],
          "properties": {
            "mode": {"enum": ["generated", "installed"]},
            "base": {"type": "string", "minLength": 1},
            "handedness": {"enum": ["right", "left"]},
            "sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 16, "maximum": 96}},
            "colour_source": {"enum": ["theme", "override"]},
            "base_colour": {"$ref": "#/$defs/colour"},
            "outline_colour": {"$ref": "#/$defs/colour"},
            "watch_background": {"$ref": "#/$defs/colour"}
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bar", "osd", "notifications"],
          "properties": {
            "bar": {"$ref": "#/$defs/bar"},
            "osd": {"$ref": "#/$defs/position"},
            "notifications": {"$ref": "#/$defs/position"}
          }
        },
        "wallpaper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fit"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "fit": {"enum": ["cover", "contain", "tile"]}
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quickshell", "widgets", "gtk", "helium", "chromium", "cursor", "wallpaper", "kitty", "hyprland", "hyprlock", "btop", "micro", "glow", "code", "cursor_editor", "stylus", "powerlevel10k", "sddm", "grub"],
          "properties": {
            "quickshell": {"type": "boolean"},
            "widgets": {"type": "boolean"},
            "gtk": {"type": "boolean"},
            "helium": {"type": "boolean"},
            "chromium": {"type": "boolean"},
            "cursor": {"type": "boolean"},
            "wallpaper": {"type": "boolean"},
            "kitty": {"type": "boolean"},
            "hyprland": {"type": "boolean"},
            "hyprlock": {"type": "boolean"},
            "btop": {"type": "boolean"},
            "micro": {"type": "boolean"},
            "glow": {"type": "boolean"},
            "code": {"type": "boolean"},
            "cursor_editor": {"type": "boolean"},
            "stylus": {"type": "boolean"},
            "obsidian": {"type": "boolean"},
            "powerlevel10k": {"type": "boolean"},
            "sddm": {"type": "boolean"},
            "grub": {"type": "boolean"}
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canvas", "chrome_background", "ansi_source"],
          "properties": {
            "canvas": {"$ref": "#/$defs/colour"},
            "chrome_background": {"$ref": "#/$defs/colour"},
            "ansi_source": {"enum": ["derived", "override"]}
          }
        }
      }
    },
    "widgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "profiles"],
      "properties": {
        "profile": {"enum": ["minimal", "compact", "comfortable"]},
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimal", "compact", "comfortable"],
          "properties": {
            "minimal": {"$ref": "#/$defs/widgetProfile"},
            "compact": {"$ref": "#/$defs/widgetProfile"},
            "comfortable": {"$ref": "#/$defs/widgetProfile"}
          }
        }
      }
    }
  },
  "$defs": {
    "colour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "offset_x", "offset_y"],
      "properties": {
        "position": {"enum": ["top-left", "top-right", "bottom-left", "bottom-right", "centre-top", "centre-bottom"]},
        "offset_x": {"type": "integer"},
        "offset_y": {"type": "integer"}
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "separate_groups", "border", "edge_inset", "items", "reset_items"],
      "properties": {
        "position": {"enum": ["left", "right", "top", "bottom"]},
        "separate_groups": {"type": "boolean"},
        "border": {"type": "boolean"},
        "edge_inset": {"type": "integer", "minimum": 0, "maximum": 24},
        "radius_automatic": {"type": "boolean"},
        "radius_scale": {"type": "number", "minimum": 0, "maximum": 2},
        "density_automatic": {"type": "boolean"},
        "density_scale": {"type": "number", "minimum": 0.75, "maximum": 1.5},
        "items": {"type": "array", "minItems": 19, "items": {"$ref": "#/$defs/barItem"}},
        "reset_items": {"type": "array", "items": {"$ref": "#/$defs/barItem"}}
      }
    },
    "barItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "region", "order"],
      "properties": {
        "id": {"enum": ["power", "notes", "workspaces", "clock", "active-window-title", "battery", "notifications", "wifi", "sound", "privacy", "awake", "display", "bt", "updates", "fan", "gpu", "touchpad", "tray", "application-tray"]},
        "enabled": {"type": "boolean"},
        "region": {"enum": ["start", "centre", "end", "hidden"]},
        "order": {"type": "integer", "minimum": 0, "maximum": 99},
        "display": {"enum": ["toggle", "numeric", "icon"]},
        "orientation": {"enum": ["inward", "outward", "horizontal"]},
        "titleLength": {"enum": ["truncate", "full"]},
        "visibility": {"enum": ["always", "normal"]}
      }
    },
    "widgetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opacity", "margin", "padding", "radius", "font_size"],
      "properties": {
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "margin": {"type": "number", "minimum": 0},
        "padding": {"type": "number", "minimum": 0},
        "radius": {"type": "number", "minimum": 0},
        "font_size": {"type": "number", "minimum": 1}
      }
    }
  }
}
