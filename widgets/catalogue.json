        "path": "",
        "daysAhead": 30,
        "maxEvents": 128
      }
    },
    {
      "kind": "notes",
      "name": "Notes",
      "route": "native",
      "optional": false,
      "width": 320,
      "height": 240,
      "requiresConfiguration": [],
      "defaultSettings": {
        "title": "",
        "text": ""
      }
    },
    {
      "kind": "files",
      "name": "Files",
      "route": "native",
      "optional": false,
      "width": 360,
      "height": 280,
      "requiresConfiguration": [],
      "defaultSettings": {
        "directory": "",
        "showHidden": false,
        "maxEntries": 100
