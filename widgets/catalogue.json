        "style": "digital",
        "timezone": "local",
        "format": "24h",
        "showSeconds": false
      }
    },
    {
      "kind": "music",
      "name": "Music",
      "route": "native",
      "optional": false,
      "width": 360,
      "height": 220,
      "requiresConfiguration": [],
